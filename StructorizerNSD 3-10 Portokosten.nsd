<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-35" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" namespace="" author="Student" created="2026-06-12" changedby="Student" changed="2026-06-12" origin="Structorizer 3.32-35" text="&#34;3/10 — Portokosten&#34;" comment="&#34;&#34;" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;bestellwert = round(random.uniform(1.00, 130.00), 2)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<alternative text="&#34;bestellwert&#34;,&#34;&#60; 40 €&#34;" comment="&#34;&#34;" color="ffffff" branch_colors="," disabled="0">
			<qTrue>
				<instruction text="&#34;porto =&#34;,&#34;3.99 € (unter 40 €)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qTrue>
			<qFalse>
				<alternative text="&#34;bestellwert&#34;,&#34;&#60; 70 €&#34;" comment="&#34;&#34;" color="ffffff" branch_colors="," disabled="0">
					<qTrue>
						<instruction text="&#34;porto =&#34;,&#34;2.99 € (40–69 €)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse>
						<alternative text="&#34;bestellwert&#34;,&#34;&#60; 100 €&#34;" comment="&#34;&#34;" color="ffffff" branch_colors="," disabled="0">
							<qTrue>
								<instruction text="&#34;Ausgabe : porto =&#34;,&#34;1.99 € (70–99 €)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
							</qTrue>
							<qFalse>
								<instruction text="&#34;porto = 0 (ab 100 € → portofrei!)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
							</qFalse>
						</alternative>
					</qFalse>
				</alternative>
			</qFalse>
		</alternative>
		<instruction text="&#34;gesamtbetrag = round(bestellwert + porto, 2)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;print(f&#34;&#34;Bestellwert:  {bestellwert:.2f} €&#34;&#34;)&#34;,&#34;print(f&#34;&#34;Portokosten:  {porto:.2f} €&#34;&#34;)&#34;,&#34;print(f&#34;&#34;Gesamtbetrag: {gesamtbetrag:.2f} €&#34;&#34;)&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
</root>