<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-35" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="Student" created="2026-06-11" changedby="Student" changed="2026-06-12" origin="Structorizer 3.32-35" text="&#34;PAP 1/10 — Hundealter&#34;" comment="" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;EINGABE hundealter=INPUT()&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<alternative text="&#34;(hundealter ==1?)&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
			<qTrue>
				<instruction text="&#34;menschen-&#34;,&#34;alter = 14&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
			</qTrue>
			<qFalse>
				<alternative text="&#34;(hundealter ==2?)&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
					<qTrue>
						<instruction text="&#34;menschen-&#34;,&#34;alter = 22&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse>
						<instruction text="&#34;menschenalter = 22 + (hundealter - 2) * 5&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
					</qFalse>
				</alternative>
			</qFalse>
		</alternative>
		<instruction text="&#34;Ausgabe&#34;,&#34;print(menschenalter)&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
